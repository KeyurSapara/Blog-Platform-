#!/bin/bash
# Managed by Ansible. Run by the GitHub Actions CD pipeline through AWS SSM Run Command:
#   blog-deploy <presigned S3 URL of backend.tgz>
# Keeps the existing .env (written by Ansible) and restarts the API.
set -euo pipefail

url="$1"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

curl -fsSL "$url" -o "$tmp/backend.tgz"
tar -xzf "$tmp/backend.tgz" -C {{ app_dir }}/backend
chown -R {{ app_user }}:{{ app_user }} {{ app_dir }}/backend

cd {{ app_dir }}/backend
sudo -u {{ app_user }} HOME={{ app_dir }} npm install --omit=dev --no-audit --no-fund
systemctl restart blog-api

for _ in $(seq 1 20); do
  if curl -fs http://127.0.0.1/api/health; then
    echo
    echo "Deploy OK"
    exit 0
  fi
  sleep 3
done
echo "Health check failed after deploy"
journalctl -u blog-api -n 50 --no-pager
exit 1
