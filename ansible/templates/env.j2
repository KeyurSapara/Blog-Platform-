# Managed by Ansible - values come from Terraform (group_vars/blog.yml)
PORT={{ app_port }}

DB_HOST="{{ db_host }}"
DB_PORT={{ db_port }}
DB_NAME="{{ db_name }}"
DB_USER="{{ db_user }}"
DB_PASSWORD="{{ db_password }}"
DB_SSL_CA="{{ app_dir }}/rds-ca.pem"
DUMP_BIN=mysqldump

COGNITO_USER_POOL_ID="{{ cognito_user_pool_id }}"
COGNITO_CLIENT_ID="{{ cognito_client_id }}"

AZURE_STORAGE_CONNECTION_STRING="{{ azure_storage_connection_string }}"
AZURE_IMAGES_CONTAINER="{{ azure_images_container }}"
AZURE_BACKUPS_CONTAINER="{{ azure_backups_container }}"

CONTENT_SAFETY_ENDPOINT="{{ content_safety_endpoint }}"
CONTENT_SAFETY_KEY="{{ content_safety_key }}"
MODERATION_THRESHOLD={{ moderation_threshold }}

# AWS SNS (new-post alerts) + SES (subscription emails). Credentials come from the EC2 instance role.
AWS_REGION="{{ aws_region }}"
SNS_TOPIC_ARN="{{ sns_topic_arn }}"
SES_SENDER_EMAIL="{{ ses_sender_email }}"
BLOG_URL="{{ blog_url }}"
