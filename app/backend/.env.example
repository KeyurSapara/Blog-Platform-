# Ansible renders the real .env on the server from Terraform outputs.
# Copy to .env only for local development.
PORT=3000

# AWS RDS MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blogdb
DB_USER=blogadmin
DB_PASSWORD=change-me
# Path to the RDS CA bundle (https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem). Leave empty for local MySQL without TLS.
DB_SSL_CA=

# AWS Cognito
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Public blog URL, used for links in notification emails
BLOG_URL=http://localhost:3000

# AWS SNS + SES notifications (leave empty to disable)
AWS_REGION=us-east-1
SNS_TOPIC_ARN=
SES_SENDER_EMAIL=

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_IMAGES_CONTAINER=images
AZURE_BACKUPS_CONTAINER=backups

# Azure AI Content Safety (leave empty to disable moderation)
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
# Reject a comment if any category severity >= this value (0, 2, 4, 6)
MODERATION_THRESHOLD=2

# mysqldump binary used by the backup script
DUMP_BIN=mysqldump
